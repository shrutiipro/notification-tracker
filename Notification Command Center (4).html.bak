<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notification Command Center Â· SoulSensei</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --ink: #1E1B29;
  --ink-soft: #4B4560;
  --paper: #F6F4F1;
  --paper-raised: #FFFFFF;
  --line: #E4E0D8;
  --line-strong: #D2CCC0;
  --accent: #3F6355;
  --accent-soft: #E7EEE8;
  --accent-deep: #294439;
  --gold: #B8912E;
  --gold-soft: #F5EDD8;
  --wa: #2E9E56;
  --wa-soft: #E5F4EA;
  --em: #3E5C9A;
  --em-soft: #E9EDF6;
  --pu: #C97A3D;
  --pu-soft: #FBEDE1;
  --danger: #B4482F;
  --danger-soft: #F7E7E2;
  --radius: 10px;
  --shadow: 0 1px 2px rgba(30,27,41,0.04), 0 8px 24px -12px rgba(30,27,41,0.18);
  --font-display: 'Fraunces', serif;
  --font-body: 'Inter', -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family: var(--font-body);
  background: var(--paper);
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
}
::selection{ background: var(--accent-soft); color: var(--accent-deep); }

button{font-family:inherit;}
input,select{font-family:inherit;}

/* ============ APP SHELL ============ */
.app{
  display:grid;
  grid-template-columns: 240px 1fr;
  min-height:100vh;
}

/* ---------- SIDEBAR ---------- */
.sidebar{
  background: var(--ink);
  color: #EFEDF5;
  padding: 28px 18px;
  display:flex;
  flex-direction:column;
  position: sticky;
  top:0;
  height:100vh;
}
.brand{
  display:flex;
  flex-direction:column;
  gap:2px;
  margin-bottom: 34px;
  padding: 0 8px;
}
.brand-mark{
  font-family: var(--font-display);
  font-size: 21px;
  font-weight:600;
  letter-spacing: 0.2px;
  color: #FFFFFF;
}
.brand-sub{
  font-size: 11px;
  color: #A9A3BE;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.nav-group{ margin-bottom: 22px; }
.nav-label{
  font-size: 10.5px;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: #7A7391;
  padding: 0 10px;
  margin-bottom: 6px;
}
.nav-item{
  display:flex;
  align-items:center;
  gap:10px;
  width:100%;
  text-align:left;
  padding: 9px 10px;
  border-radius: 8px;
  background: transparent;
  border: none;
  color: #D6D2E3;
  font-size: 13.5px;
  font-weight: 500;
  cursor:pointer;
  transition: background .12s ease, color .12s ease;
}
.nav-item:hover{ background: rgba(255,255,255,0.06); color:#fff; }
.nav-item.active{ background: var(--accent); color:#fff; }
.nav-dot{
  width:6px; height:6px; border-radius:50%;
  background: currentColor; opacity:.55; flex-shrink:0;
}
.nav-item.active .nav-dot{ opacity: 1; }
.nav-count{
  margin-left:auto;
  font-family: var(--font-mono);
  font-size: 11px;
  color: #ADA7C2;
  background: rgba(255,255,255,0.08);
  padding: 1px 6px;
  border-radius: 20px;
}
.nav-item.active .nav-count{ background: rgba(255,255,255,0.22); color:#fff;}

.sidebar-foot{
  margin-top:auto;
  padding: 12px 10px 0;
  border-top: 1px solid rgba(255,255,255,0.09);
  font-size: 11.5px;
  color: #8C86A3;
  line-height:1.5;
}

/* ---------- MAIN ---------- */
.main{ padding: 30px 40px 80px; max-width: 1400px; }
.view{ display:none; }
.view.active{ display:block; animation: fadeIn .18s ease; }
@keyframes fadeIn{ from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;} }

.page-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap: 24px;
  margin-bottom: 26px;
  flex-wrap:wrap;
}
.page-title{
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 600;
  margin: 0 0 4px;
  color: var(--ink);
}
.page-desc{
  font-size: 13.5px;
  color: var(--ink-soft);
  max-width: 560px;
  margin:0;
}

/* ---------- SEARCH BAR ---------- */
.searchbar-wrap{
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--paper);
  padding: 0 0 16px;
  margin-bottom: 4px;
}
.searchbar{
  display:flex;
  align-items:center;
  gap:10px;
  background: var(--paper-raised);
  border: 1px solid var(--line-strong);
  border-radius: 12px;
  padding: 12px 16px;
  box-shadow: var(--shadow);
}
.searchbar svg{ flex-shrink:0; color: var(--ink-soft); }
.searchbar input{
  flex:1;
  border:none;
  outline:none;
  background:transparent;
  font-size: 14.5px;
  color: var(--ink);
}
.searchbar input::placeholder{ color:#A29CB5; }
.searchbar .kbd{
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--ink-soft);
  background: var(--paper);
  border: 1px solid var(--line);
  padding: 2px 6px;
  border-radius: 5px;
}
.search-clear{
  border:none;background:var(--paper);color:var(--ink-soft);
  width:22px;height:22px;border-radius:50%;cursor:pointer;
  display:none; align-items:center;justify-content:center; font-size:13px;
}

/* ---------- FILTERS ---------- */
.filters{
  display:flex;
  flex-wrap:wrap;
  gap: 8px;
  margin-bottom: 22px;
}
.filter-group{ position:relative; }
.filter-btn{
  display:flex; align-items:center; gap:6px;
  background: var(--paper-raised);
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  padding: 7px 12px 7px 13px;
  font-size: 12.5px;
  font-weight:500;
  color: var(--ink-soft);
  cursor:pointer;
  transition: border-color .12s ease, color .12s ease;
}
.filter-btn:hover{ border-color: var(--accent); color: var(--ink); }
.filter-btn.has-selection{ border-color: var(--accent); color: var(--accent-deep); background: var(--accent-soft); }
.filter-btn .chip-count{
  background: var(--accent); color:#fff; font-family:var(--font-mono);
  font-size:10px; padding:1px 5px; border-radius:20px;
}
.filter-panel{
  display:none;
  position:absolute; top: calc(100% + 6px); left:0;
  background: var(--paper-raised);
  border: 1px solid var(--line-strong);
  border-radius: 10px;
  box-shadow: var(--shadow);
  padding: 10px;
  min-width: 220px;
  max-height: 280px;
  overflow-y:auto;
  z-index: 30;
}
.filter-panel.open{ display:block; }
.filter-opt{
  display:flex; align-items:center; gap:8px;
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 13px;
  cursor:pointer;
  color: var(--ink);
}
.filter-opt:hover{ background: var(--paper); }
.filter-opt input{ accent-color: var(--accent); }
.filter-clear-all{
  border:none; background:none; color: var(--ink-soft);
  font-size: 12.5px; text-decoration: underline; cursor:pointer;
  padding: 6px 4px;
}
.filter-clear-all:hover{ color: var(--danger); }

/* ---- Journey multi-select filters (reuses the .filter-* language) ---- */
.jfilter-btn{ max-width: 260px; }
.jfilter-btn .jf-text{
  display:inline-block;
  max-width: 210px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  vertical-align:bottom;
}
.jfilter-btn[disabled]{ opacity:.5; cursor:not-allowed; }
.jfilter-btn[disabled]:hover{ border-color: var(--line-strong); color: var(--ink-soft); }
.filter-panel-actions{
  display:flex;
  gap:6px;
  padding: 2px 2px 8px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--line);
}
.filter-mini{
  flex:1;
  border: 1px solid var(--line-strong);
  background: var(--paper-raised);
  color: var(--ink-soft);
  font-size: 11.5px;
  font-weight: 600;
  padding: 5px 8px;
  border-radius: 6px;
  cursor: pointer;
}
.filter-mini:hover{ border-color: var(--accent); color: var(--accent-deep); }
.filter-empty{
  font-size: 12.5px;
  color: #B7B2C4;
  font-style: italic;
  padding: 6px 8px;
}

.active-filter-summary{
  font-size: 12.5px; color: var(--ink-soft); margin-bottom: 16px;
}
.active-filter-summary strong{ color: var(--ink); font-weight:600; }

/* ---------- OVERVIEW METRICS ---------- */
.metric-grid{
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
  margin-bottom: 34px;
}
.metric-card{
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px 18px 16px;
}
.metric-value{
  font-family: var(--font-display);
  font-size: 32px;
  font-weight:600;
  line-height:1;
  color: var(--ink);
}
.metric-label{
  font-size: 12px;
  color: var(--ink-soft);
  margin-top: 8px;
  font-weight:500;
}
.metric-card.wa .metric-value{ color: var(--wa); }
.metric-card.em .metric-value{ color: var(--em); }
.metric-card.pu .metric-value{ color: var(--pu); }
.metric-card.accent .metric-value{ color: var(--accent); }

.section-title{
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 14px;
  display:flex;
  align-items:center;
  gap: 10px;
}
.section-title .tag{
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight:500;
  color: var(--ink-soft);
  background: var(--paper-raised);
  border: 1px solid var(--line);
  padding: 2px 8px;
  border-radius: 20px;
  text-transform:none;
}

.overview-grid{
  display:grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 20px;
  margin-bottom: 10px;
}
.panel{
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 20px;
}
.breakdown-row{
  display:flex; align-items:center; gap:12px;
  padding: 9px 0;
  border-bottom: 1px solid var(--line);
  font-size: 13px;
}
.breakdown-row:last-child{ border-bottom:none; }
.breakdown-row .name{ flex:1; color: var(--ink); font-weight:500; }
.breakdown-row .bar-track{
  width:110px; height:6px; background:var(--paper); border-radius:4px; overflow:hidden;
}
.breakdown-row .bar-fill{ height:100%; background: var(--accent); border-radius:4px; }
.breakdown-row .count{ font-family: var(--font-mono); font-size:12px; color: var(--ink-soft); width:22px; text-align:right; }

/* ---------- LIBRARY GRID ---------- */
.result-count{
  font-size: 12.5px; color: var(--ink-soft); margin-bottom: 14px;
}
.card-grid{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 14px;
}
.notif-card{
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px 16px 14px;
  cursor:pointer;
  transition: border-color .12s ease, transform .12s ease, box-shadow .12s ease;
  display:flex; flex-direction:column; gap:10px;
}
.notif-card:hover{
  border-color: var(--accent);
  box-shadow: var(--shadow);
  transform: translateY(-1px);
}
.notif-card.incomplete{ opacity: 0.72; border-style: dashed; }
.notif-card-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:8px; }
.notif-usecase{ font-family: var(--font-display); font-size: 16.5px; font-weight:600; color: var(--ink); line-height:1.25; }
.notif-id{ font-family: var(--font-mono); font-size: 10px; color:#AFA9C0; white-space:nowrap; margin-top:3px;}
.notif-meta{ display:flex; flex-wrap:wrap; gap:6px; }
.pill{
  font-size: 11px; font-weight:600; padding: 3px 9px; border-radius: 999px;
  display:inline-flex; align-items:center; gap:4px;
}
.pill-session{ background: var(--gold-soft); color:#8A6A17; }
.pill-timing{ background: var(--accent-soft); color: var(--accent-deep); font-family: var(--font-mono); font-weight:500; }
.pill-flag{ background: var(--danger-soft); color: var(--danger); }
.channel-row{ display:flex; gap:6px; margin-top:2px; }
.chan-badge{
  font-size: 10.5px; font-weight:700; letter-spacing:.02em;
  padding: 4px 8px; border-radius: 6px;
  display:flex; align-items:center; gap:4px;
}
.chan-badge.on.wa{ background: var(--wa-soft); color: var(--wa); }
.chan-badge.on.em{ background: var(--em-soft); color: var(--em); }
.chan-badge.on.pu{ background: var(--pu-soft); color: var(--pu); }
.chan-badge.off{ background: var(--paper); color:#B7B2C4; }
.chan-dot{ width:6px;height:6px;border-radius:50%; background:currentColor; }

.empty-state{
  padding: 60px 20px;
  text-align:center;
  color: var(--ink-soft);
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius);
  background: var(--paper-raised);
}
.empty-state .big{ font-family:var(--font-display); font-size:19px; color:var(--ink); margin-bottom:6px; }

/* ---------- DETAIL DRAWER ---------- */
.overlay{
  position:fixed; inset:0; background: rgba(20,17,28,0.42);
  opacity:0; pointer-events:none; transition: opacity .18s ease;
  z-index: 90;
}
.overlay.open{ opacity:1; pointer-events:auto; }
.drawer{
  position:fixed; top:0; right:0; height:100vh;
  width: 560px; max-width: 92vw;
  background: var(--paper-raised);
  box-shadow: -12px 0 40px rgba(20,17,28,0.18);
  transform: translateX(100%);
  transition: transform .22s cubic-bezier(.4,0,.2,1);
  z-index: 100;
  display:flex; flex-direction:column;
}
.drawer.open{ transform: translateX(0); }
.drawer-head{
  padding: 22px 26px 16px;
  border-bottom: 1px solid var(--line);
  display:flex; justify-content:space-between; align-items:flex-start; gap:12px;
}
.drawer-close{
  border:none; background: var(--paper); color: var(--ink-soft);
  width:30px;height:30px;border-radius:50%; cursor:pointer; font-size:15px;
  display:flex;align-items:center;justify-content:center; flex-shrink:0;
}
.drawer-close:hover{ background: var(--line); color: var(--ink); }
.drawer-eyebrow{ font-family: var(--font-mono); font-size:10.5px; color: var(--ink-soft); margin-bottom:6px; letter-spacing:.04em; }
.drawer-title{ font-family: var(--font-display); font-size:22px; font-weight:600; color: var(--ink); line-height:1.2; }
.drawer-body{ padding: 20px 26px 40px; overflow-y:auto; flex:1; }

.meta-table{ display:grid; grid-template-columns: 1fr 1fr; gap: 12px 18px; margin-bottom: 24px; }
.meta-item{ font-size:13px; }
.meta-item .k{ color: var(--ink-soft); font-size:11px; text-transform:uppercase; letter-spacing:.05em; margin-bottom:3px; }
.meta-item .v{ color: var(--ink); font-weight:500; }
.meta-item .v.muted{ color:#B7B2C4; font-weight:400; font-style:italic; }

.channel-block{
  border: 1px solid var(--line);
  border-radius: var(--radius);
  margin-bottom: 16px;
  overflow:hidden;
}
.channel-block-head{
  display:flex; justify-content:space-between; align-items:center;
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
}
.channel-block.wa .channel-block-head{ background: var(--wa-soft); }
.channel-block.em .channel-block-head{ background: var(--em-soft); }
.channel-block.pu .channel-block-head{ background: var(--pu-soft); }
.channel-block-head .chname{ font-weight:700; font-size:13.5px; display:flex; align-items:center; gap:7px; }
.channel-block.wa .chname{ color: var(--wa); }
.channel-block.em .chname{ color: var(--em); }
.channel-block.pu .chname{ color: var(--pu); }
.tmpl-id{
  font-family: var(--font-mono); font-size:11px; color: var(--ink-soft);
  background: rgba(255,255,255,0.6); border:1px solid rgba(0,0,0,0.06);
  padding: 2px 8px; border-radius:5px;
}
.channel-block-body{ padding: 14px 16px 16px; }
.copy-text{
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--ink);
  background: var(--paper);
  border-radius: 8px;
  padding: 12px 14px;
  max-height: 260px;
  overflow-y:auto;
  border: 1px solid var(--line);
  font-family: var(--font-body);
}
.copy-link{
  color: var(--accent);
  text-decoration: underline;
  text-underline-offset: 2px;
  font-weight: 500;
}
.copy-link:hover{ color: var(--accent-deep); }
.not-used-text{ font-size:13px; color:#B7B2C4; font-style:italic; padding: 4px 2px; }
.copy-btn{
  margin-top:10px;
  border: 1px solid var(--line-strong);
  background: var(--paper-raised);
  color: var(--ink);
  font-size:12px; font-weight:600;
  padding: 7px 13px;
  border-radius: 7px;
  cursor:pointer;
  display:inline-flex; align-items:center; gap:6px;
  transition: background .12s ease, border-color .12s;
}
.copy-btn:hover{ border-color: var(--accent); color: var(--accent-deep); }
.copy-btn.copied{ background: var(--accent); color:#fff; border-color: var(--accent); }

.dataflag{
  margin-top: 4px;
  font-size: 12px;
  background: var(--danger-soft);
  color: var(--danger);
  padding: 8px 12px;
  border-radius: 8px;
  display:flex; gap:8px; align-items:flex-start;
}

/* ---------- JOURNEY VIEW ---------- */
.journey-controls{
  display:flex; gap:10px; margin-bottom: 26px; flex-wrap:wrap;
}
.journey-select{
  border: 1px solid var(--line-strong);
  background: var(--paper-raised);
  border-radius: 8px;
  padding: 9px 12px;
  font-size: 13px;
  color: var(--ink);
  min-width: 200px;
}

/* ---- Phase sections ---- */
.phase-block{ margin-bottom: 40px; }
.phase-head{
  display:flex; align-items:center; gap:12px;
  margin-bottom: 18px;
  padding-bottom: 12px;
  border-bottom: 2px solid currentColor;
}
.phase-head .phase-icon{
  width: 34px; height:34px; border-radius: 9px;
  display:flex; align-items:center; justify-content:center;
  background: currentColor;
  flex-shrink:0;
}
.phase-head .phase-icon svg{ color: var(--paper-raised); }
.phase-head .phase-titles{ display:flex; flex-direction:column; gap:2px; }
.phase-head .phase-name{
  font-family: var(--font-display);
  font-size: 19px; font-weight:600; color: var(--ink); line-height:1.1;
}
.phase-head .phase-sub{ font-size:12px; color: var(--ink-soft); }
.phase-head .phase-count{
  margin-left:auto;
  font-family: var(--font-mono); font-size:11px;
  color: currentColor;
  padding: 3px 10px; border-radius: 20px; font-weight:600;
}
.phase-block.phase-pre{ color: var(--em); }
.phase-block.phase-pre .phase-count{ background: var(--em-soft); }
.phase-block.phase-live{ color: var(--gold); }
.phase-block.phase-live .phase-count{ background: var(--gold-soft); }
.phase-block.phase-post{ color: var(--accent); }
.phase-block.phase-post .phase-count{ background: var(--accent-soft); }
.phase-block.phase-unspecified{ color: #9C96AE; }
.phase-block.phase-unspecified .phase-count{ background: #EFEDF3; }

.journey-track{
  position:relative;
  padding-left: 34px;
}
.journey-track::before{
  content:'';
  position:absolute; left: 10px; top: 6px; bottom: 6px; width: 2px;
  background: currentColor;
  opacity: .55;
  border-radius:2px;
}
.phase-block.phase-unspecified .journey-track::before{ background: var(--line-strong); opacity:1; }
.journey-step{ position:relative; margin-bottom: 22px; }
.journey-step:last-child{ margin-bottom:0; }
.journey-step::before{
  content:'';
  position:absolute; left: -34px; top: 4px;
  width: 12px; height:12px; border-radius:50%;
  background: var(--paper-raised);
  border: 3px solid currentColor;
}
.journey-step-label{
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--ink);
  font-weight:600;
  margin-bottom: 8px;
  letter-spacing:.03em;
  text-transform: uppercase;
}
.journey-step-label .rel-time{ color: var(--ink-soft); font-weight:500; text-transform:none; margin-left:6px; }
.journey-cards{ display:flex; flex-direction:column; gap:8px; }
.journey-card{
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 12px 14px;
  cursor:pointer;
  display:flex; justify-content:space-between; align-items:center; gap:10px;
  transition: border-color .12s ease;
}
.journey-card:hover{ border-color: var(--accent); }
.journey-card .jc-title{ font-weight:600; font-size:13.5px; color: var(--ink); }
.journey-card .jc-sub{ font-size:11.5px; color: var(--ink-soft); margin-top:2px; }

/* ---------- TEMPLATES VIEW ---------- */
.tmpl-table-wrap{
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
}
table.tmpl-table{ width:100%; border-collapse:collapse; }
table.tmpl-table th{
  text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:.05em;
  color: var(--ink-soft); padding: 12px 16px; border-bottom: 1px solid var(--line);
  background: var(--paper);
}
table.tmpl-table td{
  padding: 13px 16px; border-bottom: 1px solid var(--line); font-size:13px; vertical-align: top;
}
table.tmpl-table tr:last-child td{ border-bottom:none; }
table.tmpl-table tr{ cursor:pointer; }
table.tmpl-table tr:hover td{ background: var(--paper); }
.tmpl-id-cell{ font-family: var(--font-mono); font-size:12px; }
.tmpl-id-cell.na{ color:#C3BED0; font-style:italic; }

/* scrollbar */
::-webkit-scrollbar{ width:9px; height:9px; }
::-webkit-scrollbar-thumb{ background: var(--line-strong); border-radius: 6px; }
::-webkit-scrollbar-track{ background: transparent; }

/* Responsive */
@media (max-width: 900px){
  .app{ grid-template-columns: 1fr; }
  .sidebar{ position:static; height:auto; flex-direction:row; overflow-x:auto; padding: 14px; gap: 10px;}
  .brand{ display:none; }
  .nav-group{ display:flex; gap:6px; margin:0; }
  .nav-label{ display:none; }
  .sidebar-foot{ display:none; }
  .main{ padding: 20px 16px 60px; }
  .overview-grid{ grid-template-columns: 1fr; }
  .drawer{ width:100%; max-width:100%; }
  .meta-table{ grid-template-columns: 1fr 1fr; }
}
</style>
</head>
<body>

<div class="app">
  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="brand">
      <div class="brand-mark">Notification<br>Command Center</div>
      <div class="brand-sub">SoulSensei Â· Source of truth</div>
    </div>

    <div class="nav-group">
      <div class="nav-label">Overview</div>
      <button class="nav-item active" data-view="overview"><span class="nav-dot"></span>Overview</button>
    </div>

    <div class="nav-group">
      <div class="nav-label">Library</div>
      <button class="nav-item" data-view="library"><span class="nav-dot"></span>All Notifications<span class="nav-count" id="count-all">0</span></button>
      <button class="nav-item" data-view="whatsapp"><span class="nav-dot"></span>WhatsApp<span class="nav-count" id="count-wa">0</span></button>
      <button class="nav-item" data-view="email"><span class="nav-dot"></span>Email<span class="nav-count" id="count-em">0</span></button>
      <button class="nav-item" data-view="push"><span class="nav-dot"></span>Push<span class="nav-count" id="count-pu">0</span></button>
    </div>

    <div class="nav-group">
      <div class="nav-label">Structure</div>
      <button class="nav-item" data-view="journey"><span class="nav-dot"></span>Journey View</button>
      <button class="nav-item" data-view="templates"><span class="nav-dot"></span>Templates</button>
    </div>

    <div class="sidebar-foot">
      Source: All_notification_Tracker.xlsx<br>
      Whatsapp + Push sheets Â· 32 notifications mapped
    </div>
  </nav>

  <!-- MAIN -->
  <main class="main">

    <!-- ============ OVERVIEW ============ -->
    <section class="view active" id="view-overview">
      <div class="page-head">
        <div>
          <h1 class="page-title">Overview</h1>
          <p class="page-desc">A live snapshot of every notification currently tracked across WhatsApp and Push â calculated directly from the tracker. (This version of the tracker has no Email sheet.)</p>
        </div>
      </div>

      <div class="metric-grid" id="metric-grid"></div>

      <div class="overview-grid">
        <div class="panel">
          <div class="section-title">Notifications by session type</div>
          <div id="breakdown-session"></div>
        </div>
        <div class="panel">
          <div class="section-title">Notifications by use case</div>
          <div id="breakdown-usecase"></div>
        </div>
      </div>
    </section>

    <!-- ============ LIBRARY (shared for all/wa/em/pu) ============ -->
    <section class="view" id="view-library">
      <div class="page-head">
        <div>
          <h1 class="page-title" id="library-title">Notification Library</h1>
          <p class="page-desc" id="library-desc">Search and filter every tracked notification. Click a card to view the exact copy and template details.</p>
        </div>
      </div>

      <div class="searchbar-wrap">
        <div class="searchbar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="search-input" placeholder="Search use case, session type, timing, copy, template IDâ¦">
          <button class="search-clear" id="search-clear">â</button>
        </div>
      </div>

      <div class="filters" id="filters-row"></div>
      <div class="active-filter-summary" id="active-summary"></div>

      <div class="result-count" id="result-count"></div>
      <div class="card-grid" id="card-grid"></div>
    </section>

    <!-- ============ JOURNEY ============ -->
    <section class="view" id="view-journey">
      <div class="page-head">
        <div>
          <h1 class="page-title">Journey View</h1>
        </div>
      </div>

      <div class="filters" id="journey-filters-row"></div>

      <div id="journey-phases"></div>
    </section>

    <!-- ============ TEMPLATES ============ -->
    <section class="view" id="view-templates">
      <div class="page-head">
        <div>
          <h1 class="page-title">Template Library</h1>
          <p class="page-desc">Every notification mapped to its channel Template IDs, pulled directly from the tracker's Template ID columns.</p>
        </div>
      </div>

      <div class="searchbar-wrap">
        <div class="searchbar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" id="tmpl-search-input" placeholder="Search template ID, use case, session typeâ¦">
        </div>
      </div>

      <div class="tmpl-table-wrap">
        <table class="tmpl-table">
          <thead>
            <tr>
              <th>Use Case</th>
              <th>Session Type</th>
              <th>WhatsApp Template ID</th>
              <th>Email Template ID</th>
              <th>Push Template ID</th>
            </tr>
          </thead>
          <tbody id="tmpl-tbody"></tbody>
        </table>
      </div>
    </section>

  </main>
</div>

<!-- DETAIL DRAWER -->
<div class="overlay" id="overlay"></div>
<div class="drawer" id="drawer">
  <div class="drawer-head">
    <div>
      <div class="drawer-eyebrow" id="drawer-eyebrow">RECORD</div>
      <div class="drawer-title" id="drawer-title">â</div>
    </div>
    <button class="drawer-close" id="drawer-close">â</button>
  </div>
  <div class="drawer-body" id="drawer-body"></div>
</div>

