"sessionTypes": ["1-on-1"], "useCases": ["Follow Up"], "timings": ["T + 30 Min"], "timingSortKey": 30, "phaseRaw": "Post- session", "phase": "post", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Leader Joins, User Does Not Join - Only User\n\nThis is a reminder for joining your upcoming session!\n\nAnant testing has joined and is waiting for you.\n\nPlease join here - https://www.soulsensei.in/leader/one-on-one/anant-testing/join/1de157fa-a626-43ff-b9c2-c7524cb672d1?utm_source=notification&utm_medium=whatsapp&utm_campaign=1_1_leaderWaiting_user&spk=677be676-2200-4bdd-aeed-45ca69222383345\n\nTeam SoulSensei", "templateId": null, "platform": "Wati"}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-028", "sourceRowWhatsapp": 29, "sourceRowPush": null, "sessionTypeRaw": "1-on-1", "useCaseRaw": "Follow Up, Recording + Feedback", "timingRaw": "T + 30 Min", "sessionTypes": ["1-on-1"], "useCases": ["Follow Up", "Recording + Feedback"], "timings": ["T + 30 Min"], "timingSortKey": 30, "phaseRaw": "Post- session", "phase": "post", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Hi Shruti,\n\nHope youâre doing well.\n\nWe hope you had a wonderful session with Maana H Tamhankar and truly enjoyed your personal SoulSession experience.\n\nWeâd appreciate it if you could share your feedback here â https://forms.gle/ACsfDYZpyShZ4YJ19. You may also send it as a quick voice note or video.\n\n If you wish to schedule your next session, you can do so here - https://www.soulsensei.in/one-on-one/listing\n\nThank you for being a part of the SoulSensei community!\n\nTeam SoulSensei", "templateId": "a881c8f2-7f0b-435c-ade3-2ef0589ec50a", "platform": "Gupshup"}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-029", "sourceRowWhatsapp": 30, "sourceRowPush": null, "sessionTypeRaw": "Group Offline", "useCaseRaw": "Registration Success", "timingRaw": "Immediate", "sessionTypes": ["Group Offline"], "useCases": ["Registration Success"], "timings": ["Immediate"], "timingSortKey": 0, "phaseRaw": "Pre-session", "phase": "pre", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Hi Soul Seeker,\n\nYour Registration Is Successful!\n\nPyaar Parivar Paisa with Kavyal Sedanni\n\nNo. of Tickets : 1\nDate : 24th June 2026\nTime : 5:50 PM - 8:50 PM IST\nLocation : Chinmaya Mission Centre, Lodhi Road, New Delhi - 110003\nhttps://maps.app.goo.gl/kLhzuPH2HmK2WSpy7\n\nClick here to view your ticket: \nhttps://stg.soulsensei.in/s/bK?spk=f833d927-7278-41c8-8c71-d79d42e82bcd345\n\nImportant Information:\n1. Gates open at 05:20 PM IST\n2. Please show this ticket at the entry\n3. Seats are on a first-come basis\n4. Parking is not available at the venue\n\nNeed Help?\nReach us at: +91 9930011706\n\nTeam SoulSensei", "templateId": null, "platform": "Wati"}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-030", "sourceRowWhatsapp": 31, "sourceRowPush": null, "sessionTypeRaw": "Group Offline", "useCaseRaw": "Session Reminder", "timingRaw": "T - 6 Hours", "sessionTypes": ["Group Offline"], "useCases": ["Session Reminder"], "timings": ["T - 6 Hours"], "timingSortKey": -360, "phaseRaw": "Pre-session", "phase": "pre", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Hello Soul Seeker,\n\nThis is a reminder for your scheduled in-person session today.\n\nEvent: Pyaar Parivar Paisa\nLeader: Kavyal Sedanni\nDate: Today\nStart time: 05:55 PM IST\nLocation: Chinmaya Mission Centre, Lodhi Road, New Delhi - 110003\nVenue link: https://maps.app.goo.gl/kLhzuPH2HmK2WSpy7\nEntry opens at 05:25 PM IST (first come, first seated)\n\nTicket link: https://stg.soulsensei.in/s/bZ?spk=df7a537d-7b4a-457f-a359-9a3a0936bdad345\n\nImportant information:\n- Keep your ticket with the barcode available on your phone for entry\n- Arrive before the session start time\n- Parking is not available at the venue\n\nFor assistance, contact: +919930011706\n\nâ SoulSensei", "templateId": null, "platform": null}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-031", "sourceRowWhatsapp": 32, "sourceRowPush": null, "sessionTypeRaw": "Group Offline", "useCaseRaw": "Session Reminder", "timingRaw": "T -  30 Min", "sessionTypes": ["Group Offline"], "useCases": ["Session Reminder"], "timings": ["T -  30 Min"], "timingSortKey": -30, "phaseRaw": "Pre-session", "phase": "pre", "channelsUsed": [], "whatsapp": {"used": false, "copy": null, "templateId": null, "platform": null}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-032", "sourceRowWhatsapp": 33, "sourceRowPush": null, "sessionTypeRaw": "Group Offline", "useCaseRaw": "Abandoned Cart", "timingRaw": "T + 30 Min", "sessionTypes": ["Group Offline"], "useCases": ["Abandoned Cart"], "timings": ["T + 30 Min"], "timingSortKey": 30, "phaseRaw": "Post- session", "phase": "post", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Hi Shruti ,\n\nYour payment for \"Pyaar Parivar Paisa\" by Kavyal Sedanni was not processed.\n\nSession details:\n\nSeats: 1\nDate: 28th June 2026\nTime: 4:00 PM - 7:00 PM IST\n\nTo complete registration, click here: https://www.soulsensei.in/course/pyaar-parivar-paisa?instance=3159&utm_source=notification&utm_medium=whatsapp&utm_campaign=register_pending_24h\nIncludes a complimentary online session with your booking.\n\nQuestions? Contact +91 9930011706\n\nWeâre here if you need anything.\nTeam SoulSensei", "templateId": null, "platform": "Wati"}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}]

</script>

<script>
// ================= DATA =================
const RAW = JSON.parse(document.getElementById('notif-data').textContent);

// channel meta
const CHANNELS = [
  { key: 'whatsapp', short: 'wa', label: 'WhatsApp' },
  { key: 'email', short: 'em', label: 'Email' },
  { key: 'push', short: 'pu', label: 'Push' },
];

// ================= STATE =================
const state = {
  view: 'overview',
  search: '',
  channelScope: null, // 'whatsapp' | 'email' | 'push' | null (all)
  filters: {
    sessionType: new Set(),
    useCase: new Set(),
    timing: new Set(),
    channel: new Set(),
    phase: new Set(),
  },
};

// ================= HELPERS =================
function uniqueSorted(values) {
  return Array.from(new Set(values.filter(Boolean))).sort((a, b) => a.localeCompare(b));
}

function allSessionTypes() {
  return uniqueSorted(RAW.flatMap(r => r.sessionTypes));
}
function allUseCases() {
  return uniqueSorted(RAW.flatMap(r => r.useCases));
}
function allTimings() {
  return uniqueSorted(RAW.flatMap(r => r.timings));
}

function escapeHtml(str) {
  if (str === null || str === undefined) return '';
  return String(str)
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;');
}

// Escape the copy, then make the URL-formatted links that are already in the
// message clickable. Two shapes are matched, in order, in a single pass:
//   1. explicit scheme URLs   https://drive.google.com/…  http://…
//   2. bare "domain + /path" URLs written without a scheme
//      e.g.  soulsensei.in/one-on-one/listing/t/maa-kaali   (a "/path" is
//      required, so ordinary sentence text with a full stop never matches)
// Everything else is left exactly as written — email addresses, phone numbers,
// and template placeholders such as {{ APP LINK CTA}}. Copy buttons still work
// because .innerText returns the link's visible text (identical to the URL).
const LINKIFY_RE = /(https?:\/\/[^\s<]+[^\s<.,;:!?)\]}'"])|((?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+(?:com|net|org|in|io|co|app|gle|link|page|dev|me)\/[^\s<]*[^\s<.,;:!?)\]}'"])/gi;
function linkify(str) {
  return escapeHtml(str).replace(LINKIFY_RE, (m, schemeUrl, bareUrl) => {
    if (schemeUrl) {
      return `<a href="${schemeUrl}" target="_blank" rel="noopener noreferrer" class="copy-link">${schemeUrl}</a>`;
    }
    return `<a href="https://${bareUrl}" target="_blank" rel="noopener noreferrer" class="copy-link">${bareUrl}</a>`;
  });
}

// Some source cells in the tracker carry an embedded (whole-cell) hyperlink in
// Excel — the URL is never written out as text, only a short label inside the
// copy is clickable (e.g. an "Image Link" line pointing to a Drive asset).
// linkify() only catches URLs typed as text, so those embedded links were lost.
// renderCopy() re-applies them: after the normal linkify pass it wraps the first
// plain-text occurrence of each label with an <a>, using the exact label text
// and exact target URL captured from the Excel source. Works for any record /
// channel that has a `hyperlinks` array; nothing else about the copy changes.
function renderCopy(str, hyperlinks) {
  let html = linkify(str);
  (hyperlinks || []).forEach(h => {
    if (!h || !h.text || !h.url) return;
    const needle = escapeHtml(h.text);
    if (!needle) return;
    const anchor = `<a href="${escapeHtml(h.url)}" target="_blank" rel="noopener noreferrer" class="copy-link">${needle}</a>`;
    let from = 0;
    while (from <= html.length) {
      const at = html.indexOf(needle, from);
      if (at === -1) break;
      // skip matches that fall inside an <a>…</a> already produced by linkify
      const before = html.slice(0, at);
      if (before.lastIndexOf('<a ') > before.lastIndexOf('</a>')) { from = at + needle.length; continue; }
      html = before + anchor + html.slice(at + needle.length);
      break;
    }
  });
  return html;
}

// Journey card subtitle: Session Type only (Use Case is already shown as the
// step/group heading in Journey View, so repeating it per-card is redundant).
function journeyCardSubtitle(rec) {
  return rec.sessionTypeRaw ? escapeHtml(rec.sessionTypeRaw) : 'â';
}

function matchesSearch(rec, q) {
  if (!q) return true;
  const hay = [
    rec.sessionTypeRaw, rec.useCaseRaw, rec.timingRaw, rec.phaseRaw,
    rec.whatsapp.copy, rec.email.copy, rec.push.copy,
    rec.whatsapp.templateId, rec.email.templateId, rec.push.templateId,
    rec.whatsapp.platform, rec.email.platform, rec.push.platform,
    rec.audience, rec.trigger, rec.owner, rec.notes, rec.status,
  ].filter(Boolean).join(' \n ').toLowerCase();
  return hay.includes(q.toLowerCase());
}

function matchesFilters(rec) {
  const f = state.filters;
  if (f.sessionType.size && !rec.sessionTypes.some(v => f.sessionType.has(v))) return false;
  if (f.useCase.size && !rec.useCases.some(v => f.useCase.has(v))) return false;
  if (f.timing.size && !rec.timings.some(v => f.timing.has(v))) return false;
  if (f.channel.size && !rec.channelsUsed.some(v => f.channel.has(v))) return false;
  if (f.phase.size && !f.phase.has(rec.phase || 'unspecified')) return false;
  return true;
}

function getFilteredRecords() {
  return RAW.filter(rec => {
    if (state.channelScope && !rec.channelsUsed.includes(state.channelScope)) return false;
    if (!matchesFilters(rec)) return false;
    if (!matchesSearch(rec, state.search)) return false;
    return true;
  });
}

// ================= NAV =================
document.querySelectorAll('.nav-item[data-view]').forEach(btn => {
  btn.addEventListener('click', () => setView(btn.dataset.view));
});

function setView(view) {
  state.view = view;
  document.querySelectorAll('.nav-item[data-view]').forEach(b => {
    b.classList.toggle('active', b.dataset.view === view);
  });

  const isLibraryLike = ['library', 'whatsapp', 'email', 'push'].includes(view);
  document.getElementById('view-overview').classList.toggle('active', view === 'overview');
  document.getElementById('view-library').classList.toggle('active', isLibraryLike);
  document.getElementById('view-journey').classList.toggle('active', view === 'journey');
  document.getElementById('view-templates').classList.toggle('active', view === 'templates');

  if (isLibraryLike) {
    state.channelScope = ['whatsapp', 'email', 'push'].includes(view) ? view : null;
    const titles = {
      library: ['Notification Library', 'Search and filter every tracked notification. Click a card to view the exact copy and template details.'],
      whatsapp: ['WhatsApp Notifications', 'Every notification with active WhatsApp copy.'],
      email: ['Email Notifications', 'Every notification with active Email copy.'],
      push: ['Push Notifications', 'Every notification with active Push copy.'],
    };
    document.getElementById('library-title').textContent = titles[view][0];
    document.getElementById('library-desc').textContent = titles[view][1];
    renderLibrary();
  }
  if (view === 'overview') renderOverview();
  if (view === 'journey') renderJourney();
  if (view === 'templates') renderTemplates();

  window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
}

// ================= OVERVIEW =================
function renderOverview() {
  const total = RAW.length;
  const complete = RAW.filter(r => !r.incomplete);
  const waCount = RAW.filter(r => r.channelsUsed.includes('whatsapp')).length;
  const emCount = RAW.filter(r => r.channelsUsed.includes('email')).length;
  const puCount = RAW.filter(r => r.channelsUsed.includes('push')).length;
  const useCaseCount = allUseCases().length;
  const sessionTypeCount = allSessionTypes().length;
  const incompleteCount = RAW.filter(r => r.incomplete).length;

  const metrics = [
    { label: 'Total notifications', value: total, cls: '' },
    { label: 'WhatsApp notifications', value: waCount, cls: 'wa' },
    { label: 'Email notifications', value: emCount, cls: 'em' },
    { label: 'Push notifications', value: puCount, cls: 'pu' },
    { label: 'Use cases', value: useCaseCount, cls: 'accent' },
    { label: 'Session types', value: sessionTypeCount, cls: 'accent' },
    { label: 'Incomplete records', value: incompleteCount, cls: '' },
  ];

  document.getElementById('metric-grid').innerHTML = metrics.map(m => `
    <div class="metric-card ${m.cls}">
      <div class="metric-value">${m.value}</div>
      <div class="metric-label">${m.label}</div>
    </div>
  `).join('');

  // breakdown by session type
  const sessionCounts = {};
  RAW.forEach(r => r.sessionTypes.forEach(s => { sessionCounts[s] = (sessionCounts[s] || 0) + 1; }));
  const maxSession = Math.max(1, ...Object.values(sessionCounts));
  document.getElementById('breakdown-session').innerHTML = Object.entries(sessionCounts)
    .sort((a, b) => b[1] - a[1])
    .map(([name, count]) => `
      <div class="breakdown-row">
        <div class="name">${escapeHtml(name)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(count / maxSession) * 100}%"></div></div>
        <div class="count">${count}</div>
      </div>
    `).join('');

  // breakdown by use case
  const useCaseCounts = {};
  RAW.forEach(r => r.useCases.forEach(u => { useCaseCounts[u] = (useCaseCounts[u] || 0) + 1; }));
  const maxUseCase = Math.max(1, ...Object.values(useCaseCounts));
  document.getElementById('breakdown-usecase').innerHTML = Object.entries(useCaseCounts)
    .sort((a, b) => b[1] - a[1])
    .map(([name, count]) => `
      <div class="breakdown-row">
        <div class="name">${escapeHtml(name)}</div>
        <div class="bar-track"><div class="bar-fill" style="width:${(count / maxUseCase) * 100}%; background: var(--gold);"></div></div>
        <div class="count">${count}</div>
      </div>
    `).join('');

  document.getElementById('count-all').textContent = total;
  document.getElementById('count-wa').textContent = waCount;
  document.getElementById('count-em').textContent = emCount;
  document.getElementById('count-pu').textContent = puCount;
}

// ================= FILTERS UI =================
const FILTER_DEFS = [
  { key: 'sessionType', label: 'Session Type', options: allSessionTypes },
  { key: 'useCase', label: 'Use Case', options: allUseCases },
  { key: 'timing', label: 'Timing', options: allTimings },
  { key: 'channel', label: 'Channel', options: () => ['whatsapp', 'push'] },
  { key: 'phase', label: 'Phase', options: () => ['pre', 'post'] },
];

function renderFilterBar() {
  const row = document.getElementById('filters-row');
  row.innerHTML = FILTER_DEFS.map(def => {
    const opts = def.options();
    return `
      <div class="filter-group" data-key="${def.key}">
        <button class="filter-btn" data-toggle="${def.key}">
          ${def.label}
          <span class="chip-count" style="display:none">0</span>
        </button>
        <div class="filter-panel" data-panel="${def.key}">
          ${opts.map(o => `
            <label class="filter-opt">
              <input type="checkbox" value="${escapeHtml(o)}" data-filter="${def.key}">
              <span>${escapeHtml(labelize(def.key, o))}</span>
            </label>
          `).join('')}
          <button class="filter-clear-all" data-clear="${def.key}">Clear</button>
        </div>
      </div>
    `;
  }).join('');

  row.querySelectorAll('[data-toggle]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.dataset.toggle;
      document.querySelectorAll('.filter-panel').forEach(p => {
        if (p.dataset.panel !== key) p.classList.remove('open');
      });
      document.querySelector(`.filter-panel[data-panel="${key}"]`).classList.toggle('open');
    });
  });

  row.querySelectorAll('input[data-filter]').forEach(input => {
    input.addEventListener('change', () => {
      const key = input.dataset.filter;
      const set = state.filters[key];
      if (input.checked) set.add(input.value); else set.delete(input.value);
      syncFilterButtons();
      renderLibrary();
    });
  });

  row.querySelectorAll('[data-clear]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.dataset.clear;
      state.filters[key].clear();
      row.querySelectorAll(`input[data-filter="${key}"]`).forEach(i => i.checked = false);
      syncFilterButtons();
      renderLibrary();
    });
  });

  document.addEventListener('click', () => {
    document.querySelectorAll('.filter-panel').forEach(p => p.classList.remove('open'));
  });
}

function labelize(key, value) {
  if (key === 'channel') {
    return { whatsapp: 'WhatsApp', email: 'Email', push: 'Push' }[value] || value;
  }
  if (key === 'phase') {
    return { pre: 'Pre-Session', post: 'Post-Session' }[value] || value;
  }
  return value;
}

function syncFilterButtons() {
  FILTER_DEFS.forEach(def => {
    const size = state.filters[def.key].size;
    const btn = document.querySelector(`.filter-btn[data-toggle="${def.key}"]`);
    const countEl = btn.querySelector('.chip-count');
    btn.classList.toggle('has-selection', size > 0);
    countEl.style.display = size > 0 ? 'inline-flex' : 'none';
    countEl.textContent = size;
  });

  const parts = [];
  FILTER_DEFS.forEach(def => {
    const set = state.filters[def.key];
    if (set.size) parts.push(`<strong>${def.label}:</strong> ${Array.from(set).map(v => labelize(def.key, v)).join(', ')}`);
  });
  document.getElementById('active-summary').innerHTML = parts.length ? parts.join('  Â·  ') : '';
}

// ================= LIBRARY =================
function renderLibrary() {
  const results = getFilteredRecords();
  const grid = document.getElementById('card-grid');
  document.getElementById('result-count').textContent = `${results.length} of ${RAW.length} notification${RAW.length === 1 ? '' : 's'}`;

  if (!results.length) {
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1">
      <div class="big">No notifications match</div>
      Try clearing a filter or adjusting your search.
    </div>`;
    return;
  }

  grid.innerHTML = results.map(rec => cardHtml(rec)).join('');
  grid.querySelectorAll('.notif-card').forEach(card => {
    card.addEventListener('click', () => openDrawer(card.dataset.id));
  });
}

function cardHtml(rec) {
  const title = rec.useCaseRaw || 'Unspecified use case';
  const session = rec.sessionTypeRaw || 'â';
  const timing = rec.timingRaw || 'â';
  return `
    <div class="notif-card ${rec.incomplete ? 'incomplete' : ''}" data-id="${rec.id}">
      <div class="notif-card-top">
        <div class="notif-usecase">${escapeHtml(title)}</div>
        <div class="notif-id">${rec.id}</div>
      </div>
      <div class="notif-meta">
        <span class="pill pill-session">${escapeHtml(session)}</span>
        <span class="pill pill-timing">${escapeHtml(timing)}</span>
        ${rec.incomplete ? `<span class="pill pill-flag">Incomplete record</span>` : ''}
      </div>
      <div class="channel-row">
        ${CHANNELS.map(c => `
          <span class="chan-badge ${rec[c.key].used ? 'on ' + c.short : 'off'}">
            <span class="chan-dot"></span>${c.label}
          </span>
        `).join('')}
      </div>
    </div>
  `;
}

// ================= DRAWER =================
const overlay = document.getElementById('overlay');
const drawer = document.getElementById('drawer');
document.getElementById('drawer-close').addEventListener('click', closeDrawer);
overlay.addEventListener('click', closeDrawer);
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

function openDrawer(id) {
  const rec = RAW.find(r => r.id === id);
  if (!rec) return;

  const rowRefs = [];
  if (rec.sourceRowWhatsapp) rowRefs.push(`WhatsApp sheet row ${rec.sourceRowWhatsapp}`);
  if (rec.sourceRowPush) rowRefs.push(`Push sheet row ${rec.sourceRowPush}`);
  document.getElementById('drawer-eyebrow').textContent = `${rec.id} Â· ${rowRefs.join(' Â· ') || 'Source row unknown'}`;
  document.getElementById('drawer-title').textContent = rec.useCaseRaw || 'Unspecified use case';

  const metaFields = [
    ['Session Type', rec.sessionTypeRaw],
    ['Timing', rec.timingRaw],
    ['Phase', rec.phaseRaw],
    ['Audience', rec.audience],
    ['Trigger', rec.trigger],
    ['Status', rec.status],
    ['Owner', rec.owner],
    ['Last Updated', rec.lastUpdated],
    ['Version', rec.version],
  ];

  const metaHtml = metaFields.map(([k, v]) => `
    <div class="meta-item">
      <div class="k">${k}</div>
      <div class="v ${v ? '' : 'muted'}">${v ? escapeHtml(v) : 'Not available'}</div>
    </div>
  `).join('');

  const flagHtml = rec.incomplete ? `
    <div class="dataflag">â  This record is missing key fields in the source tracker (use case, session type, or all channel copy). Shown as-is rather than filled in.</div>
  ` : '';

  const channelBlocks = CHANNELS.map(c => {
    const chanData = rec[c.key];
    const tmplId = chanData.templateId;
    const platform = chanData.platform;
    const tmplLabel = tmplId
      ? escapeHtml(tmplId) + (platform ? ` <span style="opacity:.6">Â· ${escapeHtml(platform)}</span>` : '')
      : 'Template ID: Not available';
    return `
      <div class="channel-block ${c.short}">
        <div class="channel-block-head">
          <div class="chname">${c.label}</div>
          <div class="tmpl-id">${tmplLabel}</div>
        </div>
        <div class="channel-block-body">
          ${chanData.used
            ? `<div class="copy-text" id="copy-${c.short}-${rec.id}">${renderCopy(chanData.copy, chanData.hyperlinks)}</div>
               <button class="copy-btn" data-copy-target="copy-${c.short}-${rec.id}">
                 <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                 Copy copy
               </button>`
            : `<div class="not-used-text">Not used for this notification.</div>`
          }
        </div>
      </div>
    `;
  }).join('');

  document.getElementById('drawer-body').innerHTML = `
    <div class="meta-table">${metaHtml}</div>
    ${flagHtml}
    ${channelBlocks}
    ${rec.notes ? `<div class="meta-item" style="margin-top:6px;"><div class="k">Notes</div><div class="v">${linkify(rec.notes)}</div></div>` : ''}
  `;

  document.getElementById('drawer-body').querySelectorAll('[data-copy-target]').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = document.getElementById(btn.dataset.copyTarget).innerText;
      navigator.clipboard.writeText(text).then(() => {
        btn.classList.add('copied');
        const original = btn.innerHTML;
        btn.innerHTML = 'Copied â';
        setTimeout(() => { btn.classList.remove('copied'); btn.innerHTML = original; }, 1400);
      });
    });
  });

  overlay.classList.add('open');
  drawer.classList.add('open');
}

function closeDrawer() {
  overlay.classList.remove('open');
  drawer.classList.remove('open');
}

// ================= JOURNEY =================
// Phase (Pre-Session / Post-Session) now comes directly from the tracker's own
// "Phase" column â no longer inferred. Records where the tracker leaves Phase
// blank fall into "Unspecified Phase" rather than being guessed at.
const PHASES = [
  { key: 'pre', label: 'Pre-Session', sub: 'Registration through the run-up to session start', icon: iconClock() },
  { key: 'post', label: 'Post-Session', sub: 'Recap, feedback, follow-up and upsell after the session ends', icon: iconCheck() },
];

function iconClock() { return `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>`; }
function iconCheck() { return `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>`; }

// ---- Journey View multi-select filters ----
// Every Journey filter is a multi-select dropdown with checkboxes + Select all /
// Clear all. Multiple values per filter and multiple filters combine (AND across
// filters, OR within a filter). Design language is shared with the Library
// filters (.filter-btn / .filter-panel / .filter-opt).
const JOURNEY_FILTER_DEFS = [
  { key: 'sessionType', label: 'Session Type', options: () => allSessionTypes(),
    match: (rec, set) => rec.sessionTypes.some(v => set.has(v)) },
  { key: 'useCase', label: 'Use Case', options: () => allUseCases(),
    match: (rec, set) => rec.useCases.some(v => set.has(v)) },
  { key: 'phase', label: 'Session Stage', options: () => ['pre', 'post', 'unspecified'],
    match: (rec, set) => set.has(rec.phase || 'unspecified') },
  { key: 'channel', label: 'Channel', options: () => ['whatsapp', 'push'],
    match: (rec, set) => rec.channelsUsed.some(v => set.has(v)) },
  { key: 'status', label: 'Status', options: () => uniqueSorted(RAW.map(r => r.status)),
    match: (rec, set) => set.has(rec.status) },
];

const journeyFilterState = {};
JOURNEY_FILTER_DEFS.forEach(d => { journeyFilterState[d.key] = new Set(); });

function journeyLabelize(key, value) {
  if (key === 'channel') return { whatsapp: 'WhatsApp', email: 'Email', push: 'Push' }[value] || value;
  if (key === 'phase') return { pre: 'Pre-Session', post: 'Post-Session', unspecified: 'Phase Not Specified' }[value] || value;
  return value;
}

function matchesJourneyFilters(rec) {
  return JOURNEY_FILTER_DEFS.every(def => {
    const set = journeyFilterState[def.key];
    return set.size ? def.match(rec, set) : true;
  });
}

// Button text: nothing selected -> the filter's name; one -> that value;
// many -> "First, Second +N" (N = remaining count).
function journeyFilterButtonText(def) {
  const set = journeyFilterState[def.key];
  if (!set.size) return def.label;
  const vals = Array.from(set).map(v => journeyLabelize(def.key, v));
  if (vals.length === 1) return vals[0];
  return `${vals[0]}, ${vals[1]}${vals.length > 2 ? ` +${vals.length - 2}` : ''}`;
}

let journeyFilterBarBuilt = false;
function ensureJourneyFilterBar() {
  if (journeyFilterBarBuilt) return;
  const row = document.getElementById('journey-filters-row');

  row.innerHTML = JOURNEY_FILTER_DEFS.map(def => {
    const opts = def.options();
    return `
      <div class="filter-group" data-jkey="${def.key}">
        <button class="filter-btn jfilter-btn" data-jtoggle="${def.key}" ${opts.length ? '' : 'disabled'}>
          <span class="jf-text">${escapeHtml(def.label)}</span>
        </button>
        <div class="filter-panel" data-jpanel="${def.key}">
          ${opts.length ? `
            <div class="filter-panel-actions">
              <button class="filter-mini" data-jselectall="${def.key}">Select all</button>
              <button class="filter-mini" data-jclearall="${def.key}">Clear all</button>
            </div>
            ${opts.map(o => `
              <label class="filter-opt">
                <input type="checkbox" value="${escapeHtml(o)}" data-jfilter="${def.key}">
                <span>${escapeHtml(journeyLabelize(def.key, o))}</span>
              </label>
            `).join('')}
          ` : `<div class="filter-empty">Not tracked in this sheet yet</div>`}
        </div>
      </div>
    `;
  }).join('');

  // Toggle a panel open (and close any other open panel)
  row.querySelectorAll('[data-jtoggle]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const panel = btn.closest('.filter-group').querySelector('.filter-panel');
      const isOpen = panel.classList.contains('open');
      document.querySelectorAll('.filter-panel').forEach(p => p.classList.remove('open'));
      if (!isOpen) panel.classList.add('open');
    });
  });

  // Keep the panel open while ticking checkboxes / hitting the mini buttons
  row.querySelectorAll('.filter-panel').forEach(panel => {
    panel.addEventListener('click', (e) => e.stopPropagation());
  });

  row.querySelectorAll('input[data-jfilter]').forEach(input => {
    input.addEventListener('change', () => {
      const set = journeyFilterState[input.dataset.jfilter];
      if (input.checked) set.add(input.value); else set.delete(input.value);
      syncJourneyFilterButtons();
      renderJourney();
    });
  });

  row.querySelectorAll('[data-jselectall]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.dataset.jselectall;
      const set = journeyFilterState[key];
      set.clear();
      row.querySelectorAll(`input[data-jfilter="${key}"]`).forEach(i => { i.checked = true; set.add(i.value); });
      syncJourneyFilterButtons();
      renderJourney();
    });
  });

  row.querySelectorAll('[data-jclearall]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const key = btn.dataset.jclearall;
      journeyFilterState[key].clear();
      row.querySelectorAll(`input[data-jfilter="${key}"]`).forEach(i => { i.checked = false; });
      syncJourneyFilterButtons();
      renderJourney();
    });
  });

  journeyFilterBarBuilt = true;
  syncJourneyFilterButtons();
}

function syncJourneyFilterButtons() {
  JOURNEY_FILTER_DEFS.forEach(def => {
    const btn = document.querySelector(`.jfilter-btn[data-jtoggle="${def.key}"]`);
    if (!btn) return;
    const set = journeyFilterState[def.key];
    btn.classList.toggle('has-selection', set.size > 0);
    btn.querySelector('.jf-text').textContent = journeyFilterButtonText(def);
    btn.title = set.size ? Array.from(set).map(v => journeyLabelize(def.key, v)).join(', ') : def.label;
  });
}

function getSortKey(rec) {
  const isImmediate = (rec.timingRaw || '').toLowerCase().includes('immediate');
  if (isImmediate) return -1e9; // earliest step within whichever phase it belongs to
  if (rec.timingSortKey === null || rec.timingSortKey === undefined) return 1e9; // no timing â sort last within its phase
  return rec.timingSortKey;
}

function classifyPhase(rec) {
  const phase = rec.phase || 'unspecified'; // 'pre' | 'post' | 'unspecified' (Phase column blank in tracker)
  return { phase, sortKey: getSortKey(rec) };
}

function renderJourney() {
  ensureJourneyFilterBar();

  const records = RAW.filter(r => !r.incomplete).filter(matchesJourneyFilters);

  const container = document.getElementById('journey-phases');
  if (!records.length) {
    container.innerHTML = `<div class="empty-state"><div class="big">No notifications in this journey</div>Try a different combination of filters.</div>`;
    return;
  }

  // bucket records into phases
  const buckets = { pre: [], post: [], unspecified: [] };
  records.forEach(rec => {
    const { phase, sortKey } = classifyPhase(rec);
    buckets[phase].push({ rec, sortKey });
  });

  let html = '';

  PHASES.forEach(phaseDef => {
    const items = buckets[phaseDef.key];
    if (!items.length) return;

    // group by raw timing label within this phase, ordered by sortKey
    const groups = {};
    items.forEach(({ rec, sortKey }) => {
      const label = rec.timingRaw || 'Timing not specified';
      if (!groups[label]) groups[label] = { sortKey, items: [] };
      groups[label].items.push(rec);
    });
    const orderedGroups = Object.entries(groups).sort((a, b) => a[1].sortKey - b[1].sortKey);

    html += `
      <div class="phase-block phase-${phaseDef.key}">
        <div class="phase-head">
          <div class="phase-icon">${phaseDef.icon}</div>
          <div class="phase-titles">
            <div class="phase-name">${phaseDef.label}</div>
            <div class="phase-sub">${phaseDef.sub}</div>
          </div>
          <div class="phase-count">${items.length} notification${items.length === 1 ? '' : 's'}</div>
        </div>
        <div class="journey-track">
          ${orderedGroups.map(([label, group]) => `
            <div class="journey-step">
              <div class="journey-step-label">${escapeHtml(label)}</div>
              <div class="journey-cards">
                ${group.items.map(rec => `
                  <div class="journey-card" data-id="${rec.id}">
                    <div>
                      <div class="jc-title">${escapeHtml(rec.useCaseRaw || 'Unspecified use case')}</div>
                      <div class="jc-sub">${journeyCardSubtitle(rec)}</div>
                    </div>
                    <div class="channel-row">
                      ${CHANNELS.map(c => `<span class="chan-badge ${rec[c.key].used ? 'on ' + c.short : 'off'}"><span class="chan-dot"></span>${c.label}</span>`).join('')}
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  });

  // Unspecified phase â the tracker's Phase column was left blank for these rows
  if (buckets.unspecified.length) {
    const groups = {};
    buckets.unspecified.forEach(({ rec, sortKey }) => {
      const label = rec.timingRaw || 'Timing not specified';
      if (!groups[label]) groups[label] = { sortKey, items: [] };
      groups[label].items.push(rec);
    });
    const orderedGroups = Object.entries(groups).sort((a, b) => a[1].sortKey - b[1].sortKey);

    html += `
      <div class="phase-block phase-unspecified">
        <div class="phase-head">
          <div class="phase-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v.01M12 12v4"/></svg></div>
          <div class="phase-titles">
            <div class="phase-name">Phase Not Specified</div>
            <div class="phase-sub">The tracker's Phase column is blank for these rows â not placed in Pre or Post-Session</div>
          </div>
          <div class="phase-count">${buckets.unspecified.length} notification${buckets.unspecified.length === 1 ? '' : 's'}</div>
        </div>
        <div class="journey-track">
          ${orderedGroups.map(([label, group]) => `
            <div class="journey-step">
              <div class="journey-step-label">${escapeHtml(label)}</div>
              <div class="journey-cards">
                ${group.items.map(rec => `
                  <div class="journey-card" data-id="${rec.id}">
                    <div>
                      <div class="jc-title">${escapeHtml(rec.useCaseRaw || 'Unspecified use case')}</div>
                      <div class="jc-sub">${journeyCardSubtitle(rec)}</div>
                    </div>
                    <div class="channel-row">
                      ${CHANNELS.map(c => `<span class="chan-badge ${rec[c.key].used ? 'on ' + c.short : 'off'}"><span class="chan-dot"></span>${c.label}</span>`).join('')}
                    </div>
                  </div>
                `).join('')}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  container.innerHTML = html;
  container.querySelectorAll('.journey-card').forEach(card => {
    card.addEventListener('click', () => openDrawer(card.dataset.id));
  });
}

// ================= TEMPLATES =================
function renderTemplates(query) {
  const tbody = document.getElementById('tmpl-tbody');
  const q = (query || '').toLowerCase();
  const rows = RAW.filter(rec => {
    if (!q) return true;
    const hay = [
      rec.useCaseRaw, rec.sessionTypeRaw,
      rec.whatsapp.templateId, rec.email.templateId, rec.push.templateId,
      rec.whatsapp.platform, rec.email.platform, rec.push.platform,
    ].filter(Boolean).join(' ').toLowerCase();
    return hay.includes(q);
  });

  if (!rows.length) {
    tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state">No matching templates</div></td></tr>`;
    return;
  }

  tbody.innerHTML = rows.map(rec => `
    <tr data-id="${rec.id}">
      <td>${escapeHtml(rec.useCaseRaw || 'Unspecified use case')}</td>
      <td>${escapeHtml(rec.sessionTypeRaw || 'â')}</td>
      <td class="tmpl-id-cell ${rec.whatsapp.templateId ? '' : 'na'}">${rec.whatsapp.templateId ? escapeHtml(rec.whatsapp.templateId) : 'Not available'}</td>
      <td class="tmpl-id-cell ${rec.email.templateId ? '' : 'na'}">${rec.email.templateId ? escapeHtml(rec.email.templateId) : 'Not available'}</td>
      <td class="tmpl-id-cell ${rec.push.templateId ? '' : 'na'}">${rec.push.templateId ? escapeHtml(rec.push.templateId) : 'Not available'}</td>
    </tr>
  `).join('');

  tbody.querySelectorAll('tr[data-id]').forEach(tr => {
    tr.addEventListener('click', () => openDrawer(tr.dataset.id));
  });
}

document.getElementById('tmpl-search-input').addEventListener('input', (e) => renderTemplates(e.target.value));

// ================= SEARCH =================
const searchInput = document.getElementById('search-input');
const searchClear = document.getElementById('search-clear');
searchInput.addEventListener('input', () => {
  state.search = searchInput.value;
  searchClear.style.display = state.search ? 'flex' : 'none';
  renderLibrary();
});
searchClear.addEventListener('click', () => {
  searchInput.value = '';
  state.search = '';
  searchClear.style.display = 'none';
  renderLibrary();
});

// ================= INIT =================
renderFilterBar();
syncFilterButtons();
renderOverview();
renderLibrary();

</script>

</body>
</html>
