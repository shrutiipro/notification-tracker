nsei.\n\nKindly inform us if any additional details are required.\n\nTeam SoulSensei", "templateId": null, "platform": "Wati"}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-017", "sourceRowWhatsapp": 18, "sourceRowPush": null, "sessionTypeRaw": "Group Free", "useCaseRaw": "Registration Success", "timingRaw": "Immediate", "sessionTypes": ["Group Free"], "useCases": ["Registration Success"], "timings": ["Immediate"], "timingSortKey": 0, "phaseRaw": "Pre-session", "phase": "pre", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Free gift \n\nHi Soul Seeker,\n\nYou received a FREE session with your recent registration!\n\nIntroduction To Colour Therapy by Dr. Devanshi\nYour session is on June 24, 2026 at 11:00 AM IST\n\nTeam Soulsensei", "templateId": "913b946c-f50d-4e9d-9233-8f518747d228", "platform": null}, "push": {"used": false, "copy": null, "templateId": null, "platform": null}, "email": {"used": false, "copy": null, "templateId": null, "platform": null}, "incomplete": false, "audience": null, "trigger": null, "status": null, "owner": null, "lastUpdated": null, "version": null, "notes": null}, {"id": "REC-018", "sourceRowWhatsapp": 19, "sourceRowPush": null, "sessionTypeRaw": "Group Free", "useCaseRaw": "Session Reminder", "timingRaw": "T -  30 Min", "sessionTypes": ["Group Free"], "useCases": ["Session Reminder"], "timings": ["T -  30 Min"], "timingSortKey": -30, "phaseRaw": "Pre-session", "phase": "pre", "channelsUsed": ["whatsapp"], "whatsapp": {"used": true, "copy": "Hi Shruti,\n\nYour free session Daily SoulSync: Breathwork & Visualization\nstarts in 30 minutes\n\nTap to join instantly:\nhttps://stg.soulsensei.in/s/tS?spk=bba3813e-bbda-4dac-9892-4b71d2c80c6f345\n\nIf you are on a lapt